PORT=5000
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/zypergo
JWT_SECRET=your_jwt_secret_key_here
FRONTEND_URL=http://localhost:5173

# Optional Subdomain Specific Frontend URLs (defaults to FRONTEND_URL with subdomain prefix)
# RIDER_FRONTEND_URL=https://rider.zypergo.com
# HUB_FRONTEND_URL=https://hub.zypergo.com
# ADMIN_FRONTEND_URL=https://admin.zypergo.com
# CUSTOMER_FRONTEND_URL=https://customer.zypergo.com

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
GOOGLE_CLIENT_ID=your_google_client_id_here
