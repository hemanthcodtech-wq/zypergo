{
  "name": "zypergo-platform",
  "version": "1.0.0",
  "description": "ZyperGo - Complete Logistics & Supply Chain Platform",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install && npm --prefix customer-app install && npm --prefix rider-app install",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:client",
    "start": "npm --prefix server start",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev:customer": "npm --prefix client run dev:customer",
    "dev:rider": "npm --prefix client run dev:rider",
    "dev:customer:8001": "npm --prefix client run dev:customer:8001",
    "dev:rider:8002": "npm --prefix client run dev:rider:8002",
    "mobile:customer": "npm --prefix customer-app start",
    "mobile:rider": "npm --prefix rider-app start",
    "seed:admin": "npm --prefix server run seed:admin",
    "seed:locations": "npm --prefix server run seed:locations"
  },
  "keywords": [
    "logistics",
    "supply-chain",
    "delivery",
    "fleet-management"
  ],
  "author": "ZyperGo Team",
  "license": "ISC"
}
