NODE_ENV=production
PORT=5000

# Database Connection (MongoDB Atlas or self-hosted MongoDB on EC2)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/zypergo

# Security
JWT_SECRET=generate_a_secure_random_64_character_hex_string_here

# Frontend Application URL (e.g. EC2 Public IP: http://54.210.12.34 or your domain https://zypergo.com)
FRONTEND_URL=http://YOUR_EC2_PUBLIC_IP

# Optional Subdomain Specific Frontend URLs (if using custom domains later)
# RIDER_FRONTEND_URL=https://rider.zypergo.com
# HUB_FRONTEND_URL=https://hub.zypergo.com
# ADMIN_FRONTEND_URL=https://admin.zypergo.com
# CUSTOMER_FRONTEND_URL=https://customer.zypergo.com
# PARTNER_FRONTEND_URL=https://partner.zypergo.com
# HAMALI_FRONTEND_URL=https://hamali.zypergo.com

# Optional Static Serving (set to true if you want Express to serve client/dist directly without Nginx)
# SERVE_STATIC=false

# Cloudinary Configuration (for parcel & document uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP Email Configuration (e.g. Gmail App Password, AWS SES, SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="ZyperGo Logistics" <your_email@gmail.com>
SUPPORT_EMAIL=support@zypergo.com

# Google Authentication
GOOGLE_CLIENT_ID=your_google_client_id_here

# MSG91 SMS & DLT Configuration
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_dlt_template_id
MSG91_SENDER_ID=ZYPERG
DLT_ID=your_dlt_login_id
DLT_PASSWORD=your_dlt_password
MSG91_ID=your_msg91_account_email


